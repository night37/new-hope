# ============================================
# GLOBAL GITIGNORE FOR MONOREPO
# Structure: back/ (Symfony) + front/ (React/Next.js)
# ============================================

# ====================
# SYSTEM FILES
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.temp
*~

# ====================
# IDE & EDITORS 
# ====================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.buildpath
.settings/
*.sublime-*

# ====================
# GIT
# ====================
*.orig
*.rej
.gitignore.bak

# ====================
# BACKEND (Symfony)
# ====================
back/var/cache/*
!back/var/cache/.gitkeep
back/var/log/*
!back/var/log/.gitkeep
back/var/sessions/*
!back/var/sessions/.gitkeep
back/vendor/
back/bin/phpunit
back/.env
back/.env.*
!back/.env.dist
!back/.env.example
back/composer.phar
back/app/cache/*
back/app/logs/*
back/public/bundles/
back/public/uploads/
back/public/assets/vendor/
back/assets/vendor/

# DDEV
back/.ddev/

# PHPUnit
back/.phpunit.result.cache
back/phpunit.xml
back/coverage/

# ====================
# FRONTEND (React/Next.js/Vue)
# ====================

# Dependencies
front/node_modules/
front/npm-debug.log*
front/yarn-debug.log*
front/yarn-error.log*
front/lerna-debug.log*
front/.pnpm-debug.log*

# Runtime data
front/pids
front/*.pid
front/*.seed
front/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
front/lib-cov

# Coverage directory used by tools like istanbul
front/coverage/
front/*.lcov

# Dependency directories
front/jspm_packages/

# TypeScript cache
front/*.tsbuildinfo

# Optional npm cache directory
front/.npm

# Optional eslint cache
front/.eslintcache

# Optional stylelint cache
front/.stylelintcache

# Microbundle cache
front/.rpt2_cache/
front/.rts2_cache_cjs/
front/.rts2_cache_es/
front/.rts2_cache_umd/

# Optional REPL history
front/.node_repl_history

# Output of 'npm pack'
front/*.tgz

# Yarn Integrity file
front/.yarn-integrity

# Environment variables
front/.env
front/.env.*
front/.env.local
front/.env.development.local
front/.env.test.local
front/.env.production.local
!front/.env.example

# parcel-bundler cache (https://parceljs.org/)
front/.cache
front/.parcel-cache

# Next.js
front/.next/
front/out/

# Nuxt.js
front/.nuxt/
front/dist/

# React
front/build/
front/.build/

# Vue.js
front/dist/

# Svelte
front/public/build/

# Storybook build outputs
front/.out
front/.storybook-out

# Temporary folders
front/tmp/
front/temp/

# ====================
# DOCKER
# ====================
docker-compose.override.yml

# ====================
# AUTRES OUTILS
# ====================

# Sass
.sass-cache/
*.css.map
*.sass.map
*.scss.map

# ESLint
.eslintcache

# Stylelint
.stylelintcache

# Tests
coverage/
.nyc_output

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

###> lexik/jwt-authentication-bundle ###
/config/jwt/*.pem
###< lexik/jwt-authentication-bundle ###
